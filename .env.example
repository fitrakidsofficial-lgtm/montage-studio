# Application and database
AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://user:password@host:5432/database
DIRECT_URL=postgresql://user:password@host:5432/database

# Public video storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# AI generation
OPENAI_API_KEY=

# TikTok developer application
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match a redirect URI registered in TikTok Developer Portal.
TIKTOK_REDIRECT_URI=https://your-domain.example/api/oauth/tiktok/callback

# Google Cloud OAuth client with YouTube Data API v3 enabled
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must exactly match an authorized Google OAuth redirect URI.
YOUTUBE_REDIRECT_URI=https://your-domain.example/api/oauth/youtube/callback

# Optional integrations already used elsewhere in the application
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
